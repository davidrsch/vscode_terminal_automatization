{
  "name": "terminal-automatization",
  "displayName": "Terminal Automatization MCP",
  "description": "MCP server for managing VS Code terminals — list, rename, navigate, create, close, split, and send commands",
  "version": "0.2.0",
  "publisher": "davidrsch",
  "icon": "logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/davidrsch/vscode_terminal_automatization"
  },
  "engines": {
    "vscode": "^1.99.0"
  },
  "keywords": [
    "mcp",
    "terminal",
    "ai",
    "copilot",
    "model context protocol",
    "vscode",
    "terminal management"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "terminal-automatization",
        "label": "Terminal MCP"
      }
    ],
    "commands": [
      {
        "command": "terminal-automatization.showStatus",
        "title": "Show Status",
        "category": "Terminal MCP"
      },
      {
        "command": "terminal-automatization.copyMcpConfig",
        "title": "Copy MCP Configuration",
        "category": "Terminal MCP"
      },
      {
        "command": "terminal-automatization.addToMcpJson",
        "title": "Add to .vscode/mcp.json",
        "category": "Terminal MCP"
      },
      {
        "command": "terminal-automatization.restart",
        "title": "Restart Server",
        "category": "Terminal MCP"
      }
    ],
    "configuration": {
      "title": "Terminal MCP",
      "properties": {
        "terminalMcp.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Port for the Terminal MCP HTTP server (default: 0 = OS picks a free port). Set a fixed port if external MCP clients need a predictable address."
        },
        "terminalMcp.enableHttpServer": {
          "type": "boolean",
          "default": true,
          "description": "Start an HTTP server for external MCP clients (Claude Desktop, Cline, etc.). Disable if you only use VS Code's built-in MCP support to avoid port conflicts with other MCP servers."
        },
        "terminalMcp.autoConfigureMcpJson": {
          "type": "boolean",
          "default": false,
          "description": "Manually add the server to .vscode/mcp.json for non-VS Code MCP clients"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src",
    "format": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format && npm run typecheck && npm run test && npm run build",
    "package": "npx @vscode/vsce package --no-dependencies",
    "publish:vscode": "npx @vscode/vsce publish --packagePath *.vsix --skip-duplicate",
    "publish:ovsx": "npx ovsx publish *.vsix --skip-duplicate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "ovsx": "^0.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^4.21.0"
  }
}
